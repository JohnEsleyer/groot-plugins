(
    version: "1.0",
    plugins: [
        (
            name: "audio",
            description: "Simple audio synthesizer & sound effects for Groot",
            author: "John Esleyer",
            path: "../groot-plugin-audio",
            repo: "https://github.com/JohnEsleyer/groot-plugin-audio",
        ),
        (
            name: "gizmos",
            description: "2D/3D debug shape line drawer for Groot",
            author: "John Esleyer",
            path: "../groot-plugin-gizmos",
            repo: "https://github.com/JohnEsleyer/groot-plugin-gizmos",
        ),
        (
            name: "ztarget",
            description: "Z-Targeting lock-on & context camera (OoT-style) for Groot",
            author: "John Esleyer",
            path: "../groot-plugin-ztarget",
            repo: "https://github.com/JohnEsleyer/groot-plugin-ztarget",
        ),
        (
            name: "kinematics",
            description: "Action-adventure 3D kinematic character controller for Groot",
            author: "John Esleyer",
            path: "../groot-plugin-kinematics",
            repo: "https://github.com/JohnEsleyer/groot-plugin-kinematics",
        ),
        (
            name: "combat",
            description: "Melee swept hitboxes, shield blocking, and damage protocol for Groot",
            author: "John Esleyer",
            path: "../groot-plugin-combat",
            repo: "https://github.com/JohnEsleyer/groot-plugin-combat",
        ),
        (
            name: "skeletal",
            description: "Skeletal animation, bone sockets, and blend trees for Groot",
            author: "John Esleyer",
            path: "../groot-plugin-skeletal",
            repo: "https://github.com/JohnEsleyer/groot-plugin-skeletal",
        ),
        (
            name: "navmesh",
            description: "3D NavMesh spatial pathfinding and AI steering for Groot",
            author: "John Esleyer",
            path: "../groot-plugin-navmesh",
            repo: "https://github.com/JohnEsleyer/groot-plugin-navmesh",
        ),
        (
            name: "gamestate",
            description: "Zelda-style flag registry, dungeon inventory, and save system",
            author: "John Esleyer",
            path: "../groot-plugin-gamestate",
            repo: "https://github.com/JohnEsleyer/groot-plugin-gamestate",
        ),
        (
            name: "dialogue",
            description: "Typewriter dialogue, NPC choices, and cutscene text sequences",
            author: "John Esleyer",
            path: "../groot-plugin-dialogue",
            repo: "https://github.com/JohnEsleyer/groot-plugin-dialogue",
        ),
        (
            name: "audio-interactive",
            description: "Dynamic background crossfading and Ocarina melody sequence detection",
            author: "John Esleyer",
            path: "../groot-plugin-audio-interactive",
            repo: "https://github.com/JohnEsleyer/groot-plugin-audio-interactive",
        ),
    ]
)
